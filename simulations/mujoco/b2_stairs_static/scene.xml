<mujoco model="B2 on open steel stair with simplified collision">
  <!-- 官方 Unitree B2（标准纯四足版）MJCF：自由基座、12 个驱动关节和碰撞体。
       资产来自 unitree_ros/robots/b2_description_mujoco，见 models/unitree_b2_mujoco。 -->
  <include file="../../../models/unitree_b2_mujoco/xml/b2.xml"/>
  <compiler angle="radian" meshdir="../../../models/unitree_b2_mujoco/meshes" autolimits="true"/>

  <visual>
    <global offwidth="1280" offheight="720" azimuth="145" elevation="-22"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.25 0.25 0.25"/>
    <rgba haze="0.12 0.18 0.24 1"/>
    <map znear="0.02" zfar="100"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.42 0.58" rgb2="0.03 0.05 0.08" width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.16 0.18 0.20" rgb2="0.22 0.24 0.26"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.05"/>
    <material name="steel" rgba="0.42 0.48 0.54 1" specular="0.75" shininess="0.7" reflectance="0.2"/>

    <!-- STL 原始单位为 mm，因此缩放 0.001；路径相对 meshdir（B2 的 meshes 目录）。 -->
  </asset>

  <worldbody>
    <light name="key" pos="2.0 -2.5 4.0" dir="0 0 -1" directional="true"/>
    <include file="../steel_stair/stair_bodies.xml"/>
  </worldbody>

  <keyframe>
    <!-- B2 位于楼梯低端前方并朝向 +X；站姿取 unitree_rl_lab 的官方 Isaac 配置
         （hip ±0.1、前 thigh 0.8 / 后 thigh 1.0、calf −1.5），z=0.55 是投放高度，
         落地后稳定在机身约 0.402 m。关节顺序 FL/FR/RL/RR × hip/thigh/calf。 -->
    <key name="b2_stairs_home"
         qpos="-0.90 0.468 0.55 1 0 0 0 0.1 0.8 -1.5 -0.1 0.8 -1.5 0.1 1.0 -1.5 -0.1 1.0 -1.5"
         ctrl="0.1 0.8 -1.5 -0.1 0.8 -1.5 0.1 1.0 -1.5 -0.1 1.0 -1.5"/>
  </keyframe>

  <statistic center="1.55 0.468 0.70" extent="5.0"/>
</mujoco>

