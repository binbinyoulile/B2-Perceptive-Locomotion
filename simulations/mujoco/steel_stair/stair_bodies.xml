<fragment>
<!-- 钢梯 + 地面：Go2 / B2 / AS2 三个场景共用的一份几何，改尺寸只改这里。
     尺寸按 2026-11-07 现场实测：级高 0.197 m、踏面深 0.272 m、梯宽 0.81 m。
     旧的 steel_stair.STL 是 0.195/0.18/0.71 的旧尺寸，已不再引用（视觉用程序化踏板）。
     单位 m；坐标原点在楼梯低端地面，x 向楼梯上方，y 为宽度方向（中心 0.468）。 -->
    <!-- 摩擦：MuJoCo 取两个 geom 摩擦的逐元素最大值，所以这里的 1.0 会压过足端的 0.4，
         实际接触 μ=1.0。取值是"橡胶足端咬住镂空格栅"的等效口径（2026-11-07 按用户要求
         从 0.9 提到 1.0），要改只改这几处 friction 的第一位。 -->
    <geom name="floor" type="plane" size="20 20 0.1" material="grid"
          friction="1.0 0.02 0.01"/>

    <!-- 碰撞体集中在独立 body 里，便于按类别开关/统计。
         踏板按 20 mm 厚板建，板下保持悬空（真实钢梯是格栅板 + 斜梁）。
         上行第 1 级前沿 x=0.2166（沿用旧场景坐标，机器人出生点不用改）。 -->
    <body name="steel_stair_collision" pos="0 0 0">
      <!-- 第 1 级：x 0.2166..0.4886，顶 0.197 -->
      <geom name="up_step_1" type="box" pos="0.352600 0.468000 0.187000"
            size="0.136000 0.405000 0.010000" material="steel" group="3"
            friction="1.0 0.02 0.01"/>

      <!-- 第 2 级：x 0.4886..0.7606，顶 0.394 -->
      <geom name="up_step_2" type="box" pos="0.624600 0.468000 0.384000"
            size="0.136000 0.405000 0.010000" material="steel" group="3"
            friction="1.0 0.02 0.01"/>

      <!-- 第 3 级：x 0.7606..1.0326，顶 0.591 -->
      <geom name="up_step_3" type="box" pos="0.896600 0.468000 0.581000"
            size="0.136000 0.405000 0.010000" material="steel" group="3"
            friction="1.0 0.02 0.01"/>

      <!-- 中间平台：x 1.0326..3.0326，顶 0.788 -->
      <geom name="platform" type="box" pos="2.032600 0.468000 0.778000"
            size="1.000000 0.405000 0.010000" material="steel" group="3"
            friction="1.0 0.02 0.01"/>

      <!-- 两侧斜梁：纯视觉（contype=0），绕 y 轴倾斜 38°，
           让图里看得出这是钢梯而不是几块浮着的板。 -->
      <geom name="stringer_left" type="box" pos="0.624600 0.070000 0.395000"
            size="0.568000 0.020000 0.045000" quat="0.927184 0 -0.374607 0"
            material="steel" group="1" contype="0" conaffinity="0"/>
      <geom name="stringer_right" type="box" pos="0.624600 0.866000 0.395000"
            size="0.568000 0.020000 0.045000" quat="0.927184 0 -0.374607 0"
            material="steel" group="1" contype="0" conaffinity="0"/>
    </body>
</fragment>
