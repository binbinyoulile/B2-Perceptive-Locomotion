<mujoco model="Go2 flat ground PD stand baseline">
  <!-- 复用官方 Go2 模型，不复制、不修改原始 MJCF 与 OBJ。 -->
  <include file="../../../models/unitree_go2/go2.xml"/>
  <compiler angle="radian" meshdir="../../../models/unitree_go2/assets" autolimits="true"/>

  <option timestep="0.002" cone="elliptic" impratio="100"/>

  <visual>
    <global offwidth="1280" offheight="720" azimuth="145" elevation="-22"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.25 0.25 0.25"/>
    <rgba haze="0.12 0.18 0.24 1"/>
    <map znear="0.02" zfar="100"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.42 0.58" rgb2="0.03 0.05 0.08" width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.16 0.18 0.20" rgb2="0.22 0.24 0.26"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="key" pos="2.0 -2.5 4.0" dir="0 0 -1" directional="true"/>
    <!-- 地面摩擦暂按干燥水泥—橡胶足端典型值 0.8，待老师确认或实测标定。 -->
    <geom name="floor" type="plane" size="20 20 0.1" material="grid"
          friction="0.8 0.02 0.01"/>
  </worldbody>

  <keyframe>
    <!-- 初始 base 比理论触地高度高约 11.6 mm，让四足自然建立接触；
         目标关节角与官方 home 一致，控制由 stand_pd.py 在线计算。 -->
    <key name="stand_home"
         qpos="0 0.468 0.30 1 0 0 0 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"
         ctrl="0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"/>
  </keyframe>

  <statistic center="0 0.468 0.35" extent="2.0"/>
</mujoco>
